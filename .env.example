# The settings src/ reads. Copy to .env (git-ignored) and fill in. Values already set in the shell win over
# the file. Checking a day (node src/verify.js <file> --logic <contract>) needs none of them.
# src/runner.js and src/desk.js read .env with process.loadEnvFile, which needs Node 20.12 or newer (21.7 on
# the 21 line); an older Node skips the file without an error, so set the values in the shell there.

# BSC mainnet RPC for the daily runner (src/runner.js). Empty means https://bsc-dataseed.bnbchain.org, with
# two more public nodes asked when it gives no answer. src/desk.js and src/verify.js, run on their own,
# take BSC_RPC from the shell only and ask that one node. A job that fails at a node logs that node's full
# URL (console and RUNNER_DATA/runner-events.jsonl): keep that log private if the URL carries a provider key.
BSC_RPC=
# Other nodes to fall back to, comma-separated (an empty value means none).
# BSC_RPC_BACKUPS=

# The deployed StockAgentLogicV1.
STOCK_LOGIC=0x4245dd4DC9e9bC1035514C6de13C88ab91b61946

# Relayer key. It sends the agents' trades, anchors and payment approvals; each agent repays the gas from
# its own wallet. The contract accepts it only after the contract's owner (the Safe) has registered it.
RELAYER_KEY=
# Or read an existing key in place from another project's .env: set ENV_FILE in the shell, not in this
# file (comma-separated paths; src/env.js reads it before it loads .env). The name RUNTIME_PRIVATE_KEY is
# accepted there too; an empty RELAYER_KEY= line in .env hides a RELAYER_KEY from that file.
# The whole of each file is loaded, not only the key: a GAS_PRICE_GWEI or the Pinata keys found there apply
# as if set here, unless the shell or .env already sets them (an empty value counts as set).

# Optional: a fixed gas price instead of the node's quote.
# GAS_PRICE_GWEI=0.05

# ── The daily runner (src/runner.js) ──
# The two agents it runs: the Analyst (holds stocks, writes and sells notes, anchors its day) and the
# Trader (buys the Analyst's notes over x402 and makes small buys). Their NFT token ids.
ANALYST_ID=
TRADER_ID=
# The Analyst's scripted positions, as stock:USD pairs (used without ANALYST_PICK). At each open it buys
# any it does not hold, at a fair price only, so one sold at an exit level is bought back the next morning.
# ANALYST_TARGETS=NVDAB:15,QQQB:15
# The Trader's buy after it reads a note, in USD (the desk runs with 2).
# TRADER_BUY_USD=5
# The price of one note, in $U.
# NOTE_PRICE_U=0.02
# The local port of the Analyst's note seller.
# SELLER_PORT=8402
# The https address a tunnel or proxy gives the seller, if it is public: the 402 terms name it, and
# GET /notes/<id> lists each note at it. The seller itself still listens on 127.0.0.1 only.
# SELLER_PUBLIC_URL=https://notes.example.com
# Where the anchored ledgers are written (the seller serves notes from here). Git ignores it: an open
# ledger holds the notes sold during the day, and it goes public only through SITE_DIR.
# LEDGER_DIR=ledger
# Where each finished day is published after its close (site/ledger/ in this repository).
# SITE_DIR=site
# Where the runner keeps its event log, finished jobs and pid.
# RUNNER_DATA=probes/data
# Dry run: the jobs log what they would send and send nothing. Use it with the one-shot commands (open,
# trader, close, exits). Under daemon a dry job still counts as finished for that day.
# RUNNER_DRY=1

# The agent's whole record on IPFS: with both Pinata keys set, each close pins the record and anchors its
# ipfs:// address; without them the close anchors a plain label. RECORD_IPFS=0 turns pinning off.
# PINATA_API_KEY=
# PINATA_SECRET_API_KEY=
# RECORD_IPFS=1

# Trading rules (src/rules.js), for both agents. Buy only when one share costs at most BUY_MAX_PREMIUM_BPS
# basis points over the real share (100 = 1%); trust no pool and reference further apart than PRICE_SANITY_BPS. An exit plan is the same
# distance both ways: TAKE_PROFIT_BPS until the desk has three days of history for the stock, then sized from
# the stock's typical move. The Trader copies its note's levels; STOP_LOSS_BPS is read only when the note
# carries none.
# BUY_MAX_PREMIUM_BPS=20
# PRICE_SANITY_BPS=100
# TAKE_PROFIT_BPS=300
# STOP_LOSS_BPS=300
# How often positions are checked against their exit levels, in minutes.
# EXIT_EVERY_MIN=15

# Pick mode (src/claims.js): the Analyst holds the ANALYST_PICK best-tracking stocks the contract lists
# for buys, ANALYST_POSITION_USD each, and replaces one only when it falls out of the top
# ANALYST_KEEP_TOP (or is no longer listed for buys). Without ANALYST_PICK it keeps the fixed
# ANALYST_TARGETS. The desk runs with 2 and 15.
# ANALYST_PICK=2
# ANALYST_POSITION_USD=15
# ANALYST_KEEP_TOP=4
